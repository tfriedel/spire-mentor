#!/usr/bin/env bash
# LFS-aware pre-push hook for Claude Code cloud sessions (GH #1162).
#
# The stock hook that `git lfs install` writes runs `git lfs pre-push`
# unconditionally. In a cloud session the GitHub proxy authenticates plain git
# but not the LFS API, so that call fails ("Git credentials for ... not found")
# and aborts EVERY push, even one that adds no LFS object.
#
# This wrapper runs `git lfs pre-push` only when a pushed commit touches an
# LFS-tracked path (filter=lfs at that commit). Otherwise LFS has nothing to
# upload, so the hook exits 0 and the push goes through without --no-verify.
# Whenever it cannot tell, it falls back to `git lfs pre-push` and its error.
#
# claude_code_web_init.sh installs it as the repo's pre-push hook, in cloud
# sessions only. Local checkouts keep the stock LFS hook.
set -uo pipefail

ZERO=0000000000000000000000000000000000000000

run_lfs() {
  command -v git-lfs >/dev/null 2>&1 || {
    echo >&2 "pre-push: this push touches LFS files but git-lfs is not on PATH."
    exit 2
  }
  printf '%s' "$input" | git lfs pre-push "$@"
  exit $?
}

input="$(cat)"
[ -n "$input" ] || exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  # A deletion uploads nothing.
  [ "${local_sha//0/}" = "" ] && continue

  if [ "${remote_sha//0/}" != "" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    range=("${remote_sha}..${local_sha}")
  else
    # New branch, or the remote tip is not in this clone: everything not yet
    # on any remote-tracking ref.
    range=("$local_sha" --not --remotes)
  fi

  paths="$(git log --format= --name-only --no-renames "${range[@]}" 2>/dev/null)" || run_lfs "$@"
  [ -n "$paths" ] || continue

  # Attributes as of the pushed commit, so a .gitattributes change in the push
  # itself counts.
  attrs="$(printf '%s\n' "$paths" | sort -u \
    | git check-attr --stdin --source="$local_sha" filter 2>/dev/null)" \
    || run_lfs "$@"   # check-attr failed: let LFS decide
  if printf '%s\n' "$attrs" | grep -q ': filter: lfs$'; then
    run_lfs "$@"
  fi
done <<< "$input"

exit 0
