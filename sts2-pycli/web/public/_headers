# Cloudflare Pages headers for the static site (deploy/DEPLOY.md has the table).
# Pages MERGES the values of a header set by several matching rules, so each
# specific rule first detaches (`! Name`) what the catch-all set. Pages sets
# Content-Type from the extension; the art is WebP shipped under .png names
# (scripts/art_to_dist.py), hence the override.
/*
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache
/wb-assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
# The engine ships gzipped (*.wasm-<hash>.gz) and the worker inflates it
# (src/worker/wasmLoad.ts): opaque bytes, so octet-stream (not compressed on
# the fly) and no-transform (Cloudflare must not re-encode or strip it).
/wb-assets/*.gz
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform
  ! Content-Type
  Content-Type: application/octet-stream
/ppo/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  ! Content-Type
  Content-Type: application/octet-stream
/e2e/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  ! Content-Type
  Content-Type: application/octet-stream
/ppo/index.json
  ! Cache-Control
  Cache-Control: no-cache
  ! Content-Type
  Content-Type: application/json
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
/assets/*.png
  ! Content-Type
  Content-Type: image/webp
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
/icons/*
  ! Cache-Control
  Cache-Control: public, max-age=604800
